#!/bin/sh
# archivist — deterministic reads over Claude Code's auto-memory and its
# session transcripts. Invoke as: sh <skill-root>/bin/archivist <command>
#
#   locate                            print the two directories in use
#   signals [--days N | --since DATE] print what the user said, one line each
#   check                             check the memory against its grammar
#
# The memory directory comes from autoMemoryDirectory in the user
# settings of Claude Code, and the transcripts live under projects/ in
# the same configuration directory. Two environment variables override
# that lookup, for tests and for a machine with another layout:
# ARCHIVIST_MEMORY_DIRECTORY and ARCHIVIST_TRANSCRIPTS_DIRECTORY.
#
# This is POSIX sh. It needs jq.

set -eu

SELF=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
PROGRAMS=$SELF/../jq

DEFAULT_WINDOW_DAYS=7
SECONDS_PER_DAY=86400

# Claude Code loads only the head of the index into a session.
INDEX_LINE_LIMIT=200
INDEX_BYTE_LIMIT=25600

# A finding quotes the offending line up to this length, so that a
# report stays one line per finding.
EXCERPT_LENGTH=60

MEMORY_TYPES='user feedback project reference'
RELATIVE_DATE='(^|[^A-Za-z])(yesterday|today|tomorrow|(last|next|this) (week|month|year)|[0-9]+ (days|weeks|months|years) ago)([^A-Za-z]|$)'
ABSOLUTE_DATE='[0-9]{4}-[0-9]{2}-[0-9]{2}'

die() {
  echo "archivist: $1" >&2
  exit "${2:-1}"
}

configuration_directory() {
  printf '%s' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
}

# A person writes a setting the way a person writes a path, so it can
# arrive with a leading tilde that no shell has expanded. The tilde sits
# in a variable, so that it reads as the character and not as a failed
# expansion of this script's own.
expand_tilde() {
  tilde='~'
  case $1 in
    "$tilde") printf '%s' "$HOME" ;;
    "$tilde"/*) printf '%s/%s' "$HOME" "${1#"$tilde"/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

memory_directory() {
  if [ -n "${ARCHIVIST_MEMORY_DIRECTORY:-}" ]; then
    expand_tilde "$ARCHIVIST_MEMORY_DIRECTORY"
    return
  fi

  settings=$(configuration_directory)/settings.json
  configured_memory=''
  if [ -r "$settings" ]; then
    configured_memory=$(jq -r '.autoMemoryDirectory // empty' "$settings" 2>/dev/null || true)
  fi
  if [ -n "$configured_memory" ]; then
    expand_tilde "$configured_memory"
    return
  fi

  # The default of Claude Code: one memory directory per project, named
  # after the working directory with every other character turned into
  # a dash.
  project_name=$(printf '%s' "$PWD" | sed 's/[^A-Za-z0-9]/-/g')
  printf '%s/projects/%s/memory' "$(configuration_directory)" "$project_name"
}

transcripts_directory() {
  if [ -n "${ARCHIVIST_TRANSCRIPTS_DIRECTORY:-}" ]; then
    expand_tilde "$ARCHIVIST_TRANSCRIPTS_DIRECTORY"
    return
  fi
  printf '%s/projects' "$(configuration_directory)"
}

locate_directories() {
  echo "memory: $(memory_directory)"
  echo "transcripts: $(transcripts_directory)"
}

# Print what the user said inside the window, one utterance per line,
# oldest first. The window is the last N days, or everything since a
# date or a timestamp.
gather_signals() {
  window_days=$DEFAULT_WINDOW_DAYS
  window_start=''
  while [ $# -gt 0 ]; do
    case $1 in
      --days|--since)
        [ $# -ge 2 ] || die 'usage: archivist signals [--days N | --since YYYY-MM-DD]' 2
        if [ "$1" = --days ]; then window_days=$2; else window_start=$2; fi
        shift 2 ;;
      *) die 'usage: archivist signals [--days N | --since YYYY-MM-DD]' 2 ;;
    esac
  done

  if [ -n "$window_start" ]; then
    case $window_start in
      [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) window_start="${window_start}T00:00:00Z" ;;
    esac
    jq -n -e --arg start "$window_start" '$start | try fromdate catch false' >/dev/null 2>&1 \
      || die "The start of the window must be a date or a timestamp; given was '$window_start'." 2
    window_days=$(jq -n -r --arg start "$window_start" --arg seconds_per_day "$SECONDS_PER_DAY" \
      '((now - ($start | fromdate)) / ($seconds_per_day | tonumber) | ceil)
       | if . < 1 then 1 else . end')
  else
    case $window_days in
      ''|*[!0-9]*) die "The window must be a whole number of days; given was '$window_days'." 2 ;;
    esac
    [ "$window_days" -ge 1 ] || die "The window must be at least one day; given was '$window_days'." 2
    window_start=$(jq -n -r --arg days "$window_days" --arg seconds_per_day "$SECONDS_PER_DAY" \
      '(now - ($days | tonumber) * ($seconds_per_day | tonumber)) | todate')
  fi

  transcripts=$(transcripts_directory)
  [ -d "$transcripts" ] || die "No transcripts directory exists at $transcripts." 2
  set -- "$transcripts"/*/*.jsonl
  [ -f "$1" ] || die "No transcript sits under $transcripts." 2

  # Transcripts sit one directory deep, one file per session. find
  # rounds the age of a file up to whole days, so the file filter gets
  # a day of slack; the timestamp filter inside jq is the exact one.
  slack_days=1
  find "$@" -prune -mtime "-$((window_days + slack_days))" \
    -exec jq -R -r --arg since "$window_start" -f "$PROGRAMS/signals.jq" {} + | sort
}

# Every line of the index is blank, a heading, or a pointer at a file
# that exists, and no file gets two pointers. awk classifies the lines;
# the shell checks the files, because awk has no clean file test.
check_index() {
  memory=$1
  index=$2
  tab=$(printf '\t')
  awk -v excerpt_length="$EXCERPT_LENGTH" '
    /^[ \t]*$/ || /^#/ { next }
    {
      if (match($0, /\]\([A-Za-z0-9._-]+\.md\)/)) {
        target = substr($0, RSTART + length("]("), RLENGTH - length("](") - length(")"))
        if (pointed_at[target]++) printf "twice\t%d\t%s\n", NR, target
        else printf "pointer\t%d\t%s\n", NR, target
      } else {
        printf "content\t%d\t%s\n", NR, substr($0, 1, excerpt_length)
      }
    }
  ' "$index" | while IFS="$tab" read -r kind line_number detail; do
    case $kind in
      pointer)
        [ -f "$memory/$detail" ] || \
          echo "FAIL: MEMORY.md line $line_number points at $detail, which does not exist." ;;
      twice) echo "FAIL: MEMORY.md line $line_number points at $detail twice." ;;
      content) echo "FAIL: MEMORY.md line $line_number is not a pointer line: \"$detail\"" ;;
    esac
  done
}

# The frontmatter opens the file, closes, names the file by its own
# filename, carries a description, and carries one of the four types.
check_frontmatter() {
  memory_file=$1
  memory_name=$2
  awk -v name="$memory_name" -v types="$MEMORY_TYPES" '
    BEGIN {
      types_pattern = types; gsub(/ /, "|", types_pattern)
      types_readable = types; gsub(/ /, ", ", types_readable)
    }
    NR == 1 && $0 != "---" {
      print "FAIL: " name ".md does not open with a frontmatter block."
      block_is_absent = 1
      exit
    }
    /^---[ \t]*$/ { fences++; next }
    fences == 1 && /^name:/ { declared_name = $0; sub(/^name:[ \t]*/, "", declared_name) }
    fences == 1 && /^description:/ { description = $0; sub(/^description:[ \t]*/, "", description) }
    fences == 1 && /^[ \t]+type:/ { type = $0; sub(/^[ \t]+type:[ \t]*/, "", type) }
    fences >= 2 { exit }
    END {
      if (NR == 0) { print "FAIL: " name ".md does not open with a frontmatter block."; exit }
      if (block_is_absent) exit
      if (fences < 2) { print "FAIL: " name ".md has no complete frontmatter block."; exit }
      if (declared_name != name)
        print "FAIL: " name ".md declares name \"" declared_name "\", not its own filename."
      if (description == "") print "FAIL: " name ".md declares no description."
      if (type !~ "^(" types_pattern ")$")
        print "FAIL: " name ".md declares type \"" type "\", not one of " types_readable "."
    }
  ' "$memory_file"
}

# A relative date loses its meaning with every day that passes. It is a
# defect unless an absolute date sits on the same line to anchor it.
check_dates() {
  memory_file=$1
  memory_name=$2
  grep -n -i -E "$RELATIVE_DATE" "$memory_file" \
    | grep -v -E "$ABSOLUTE_DATE" \
    | while IFS= read -r offending; do
        line_number=${offending%%:*}
        excerpt=$(printf '%s' "${offending#*:}" | sed 's/^[ \t]*//' | cut -c1-"$EXCERPT_LENGTH")
        echo "FAIL: ${memory_name}.md line $line_number has a relative date: \"$excerpt\""
      done
}

# A link without a file marks a memory still to write, or a link to
# drop. The reader decides which, so it is a warning and not a defect.
check_links() {
  memory_file=$1
  memory_name=$2
  memory=$3
  awk '{
    remainder = $0
    while (match(remainder, /\[\[[^]]+\]\]/)) {
      print substr(remainder, RSTART + length("[["), RLENGTH - length("[[") - length("]]"))
      remainder = substr(remainder, RSTART + RLENGTH)
    }
  }' "$memory_file" | sort -u | while IFS= read -r target; do
    [ -f "$memory/$target.md" ] || \
      echo "WARN: ${memory_name}.md links to [[${target}]], which has no file yet."
  done
}

list_findings() {
  memory=$1
  index=$memory/MEMORY.md
  if [ ! -f "$index" ]; then
    echo 'FAIL: MEMORY.md is missing.'
    return 0
  fi

  index_lines=$(wc -l < "$index" | tr -d ' ')
  [ "$index_lines" -le "$INDEX_LINE_LIMIT" ] || \
    echo "FAIL: MEMORY.md has $index_lines lines; Claude loads the first $INDEX_LINE_LIMIT only."
  index_bytes=$(wc -c < "$index" | tr -d ' ')
  [ "$index_bytes" -le "$INDEX_BYTE_LIMIT" ] || \
    echo "FAIL: MEMORY.md has $index_bytes bytes; Claude loads the first $INDEX_BYTE_LIMIT only."

  check_index "$memory" "$index"
  check_dates "$index" MEMORY

  for memory_file in "$memory"/*.md; do
    [ -f "$memory_file" ] || continue
    memory_name=${memory_file##*/}
    memory_name=${memory_name%.md}
    [ "$memory_name" != MEMORY ] || continue
    grep -q -F "](${memory_name}.md)" "$index" || \
      echo "FAIL: ${memory_name}.md has no line in MEMORY.md."
    check_frontmatter "$memory_file" "$memory_name"
    check_dates "$memory_file" "$memory_name"
    check_links "$memory_file" "$memory_name" "$memory"
  done
}

# Check the memory directory against its grammar. Print one FAIL line
# per defect and one WARN line per link without a file, then OK when no
# FAIL line came out. Exit 1 on any FAIL.
check_memory() {
  [ $# -eq 0 ] || die 'usage: archivist check' 2
  memory=$(memory_directory)
  [ -d "$memory" ] || die "No memory directory exists at $memory." 2
  findings=$(list_findings "$memory")
  [ -z "$findings" ] || echo "$findings"
  if printf '%s\n' "$findings" | grep -q '^FAIL: '; then
    exit 1
  fi
  echo OK
}

command_name=${1:-}
[ -n "$command_name" ] || die 'usage: archivist <locate|signals|check> [args]' 2
shift
case $command_name in
  locate) locate_directories "$@" ;;
  signals) gather_signals "$@" ;;
  check) check_memory "$@" ;;
  *) die "There is no command named '$command_name'." 2 ;;
esac
