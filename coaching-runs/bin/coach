#!/bin/sh
# coach — deterministic reads and writes for a run-coaching workspace.
# Run it from the workspace directory. The workspace must hold plan.json.
# Invoke as: sh <skill-root>/bin/coach <command> [args]

set -eu

SELF=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
JQ_DIR=$SELF/../jq

die() {
  echo "coach: $1" >&2
  exit "${2:-1}"
}

require_workspace() {
  [ -f plan.json ] || die "not a coaching workspace: plan.json not found in $(pwd)" 2
}

# Print the front matter of a journal file as one JSON object.
# Scalar values stay strings. Repeated "carry" items become an array.
# The parser reads only the first --- block, splits each line on its
# first colon, and strips one pair of surrounding quotes from list items.
fm_json() {
  awk '
    /^---[ ]*$/ { fence += 1; next }
    fence != 1 { next }
    /^[A-Za-z][A-Za-z0-9]*:/ {
      key = $0; sub(/:.*$/, "", key)
      val = $0; sub(/^[^:]*:[ ]*/, "", val)
      list = ""
      if (val == "") { list = key; next }
      printf "%s\t%s\n", key, val
      next
    }
    /^[ ]+-[ ]/ {
      if (list != "") {
        item = $0
        sub(/^[ ]+-[ ]/, "", item)
        sub(/^"/, "", item); sub(/"$/, "", item)
        printf "%s\t%s\n", list, item
      }
      next
    }
  ' "$1" | jq -R -s '
    [ split("\n")[] | select(length > 0)
      | index("\t") as $i | {key: .[:$i], value: .[$i+1:]} ]
    | (map(select(.key != "carry")) | from_entries)
      + {carry: [.[] | select(.key == "carry") | .value]}
  '
}

# Print every journal entry as a JSON array of front-matter objects,
# each with a "file" key carrying its path.
journal_array() {
  {
    if [ -d journal ]; then
      for jf in journal/*.md; do
        [ -f "$jf" ] || continue
        fm_json "$jf" | jq --arg file "$jf" '. + {file: $file}'
      done
    fi
  } | jq -s '.'
}

# Print the open-ruling titles from rulings.md as a JSON array.
open_rulings() {
  {
    if [ -f rulings.md ]; then
      awk '
        /^## /  { open = ($0 == "## Open"); next }
        open && /^### / { sub(/^### /, ""); print }
      ' rulings.md
    fi
  } | jq -R -s '[split("\n")[] | select(length > 0)]'
}

cmd_status() {
  require_workspace
  status_date=${1:-$(date '+%Y-%m-%d')}
  jq -r \
    --arg today "$status_date" \
    --argjson journal "$(journal_array)" \
    --argjson rulings "$(open_rulings)" \
    -f "$JQ_DIR/status.jq" plan.json
}

cmd_verify() {
  require_workspace
  verify_findings=$(jq -r --argjson journal "$(journal_array)" \
    -f "$JQ_DIR/verify.jq" plan.json)
  if [ -n "$verify_findings" ]; then
    echo "$verify_findings"
    exit 1
  fi
  echo OK
}

cmd_close_day() {
  require_workspace
  cd_amend=0
  cd_date=''
  for cd_arg in "$@"; do
    case $cd_arg in
      --amend) cd_amend=1 ;;
      *) cd_date=$cd_arg ;;
    esac
  done
  [ -n "$cd_date" ] || die 'usage: coach close-day [--amend] <date>' 2

  cd_file=''
  cd_count=0
  for cd_f in "journal/$cd_date"-*.md; do
    [ -f "$cd_f" ] || continue
    cd_file=$cd_f
    cd_count=$((cd_count + 1))
  done
  [ "$cd_count" -ge 1 ] || die "no journal file for $cd_date under journal/"
  [ "$cd_count" -eq 1 ] || die "two journal files for $cd_date; keep one"

  cd_fmdate=$(fm_json "$cd_file" | jq -r '.date // empty')
  [ "$cd_fmdate" = "$cd_date" ] || \
    die "$cd_file carries date '$cd_fmdate', not $cd_date"

  jq -e --arg d "$cd_date" 'any(.weeks[].days[]?; .date == $d)' \
    plan.json >/dev/null || die "no planned day on $cd_date"

  cd_closed=$(jq -r --arg d "$cd_date" \
    '[.weeks[].days[]? | select(.date == $d) | .workouts[]?
      | select(.sport == "run") | .completed == true] | any' plan.json)
  if [ "$cd_closed" = "true" ] && [ "$cd_amend" -eq 0 ]; then
    die "$cd_date is already closed; pass --amend to recompute it"
  fi

  cd_tmp=plan.json.tmp.$$
  if ! jq \
      --arg date "$cd_date" \
      --arg path "$cd_file" \
      --arg now "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
      --argjson journal "$(journal_array)" \
      -f "$JQ_DIR/close-day.jq" plan.json > "$cd_tmp" 2>/dev/null; then
    rm -f "$cd_tmp"
    die "close-day failed; plan.json is untouched"
  fi
  if ! jq -e '.weeks and .meta.updatedAt' "$cd_tmp" >/dev/null 2>&1; then
    rm -f "$cd_tmp"
    die "validation failed; plan.json is untouched"
  fi
  mv "$cd_tmp" plan.json
  echo "closed $cd_date via $cd_file"
}

cmd=${1:-}
[ -n "$cmd" ] || die 'usage: coach <status|verify|close-day> [args]' 2
shift
case $cmd in
  status) cmd_status "$@" ;;
  verify) cmd_verify "$@" ;;
  close-day) cmd_close_day "$@" ;;
  *) die "unknown command: $cmd" 2 ;;
esac
